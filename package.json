{
  "name": "gishin-ankin",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "play": "node --disable-warning=ExperimentalWarning packages/rules/src/cli/play.ts",
    "dev:server": "pnpm --filter @gishin-ankin/server dev",
    "bots": "pnpm --filter @gishin-ankin/server bots"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
